{
  "name": "campus-kinmen",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "node --check worker.js && node --check admin-api.js && node --check validation.js && node --check static/app.js && node --check static/admin.js",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "node --test tests/unit/validation.test.mjs",
    "test:api": "node --test tests/api/system.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "wrangler": "4.158.0",
    "@playwright/test": "1.65.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
